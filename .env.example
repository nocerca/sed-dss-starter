# Подготовьте: python scripts/setup_local.py (существующий .env сохраняется)
DATABASE_URL=postgresql+psycopg://sed:sed_dev_password@db:5432/sed_dss
APP_API_KEY=local-dev-only-change-before-exposure
# Только none (локальные правила) или openclaw. Прямые вызовы моделей запрещены.
LLM_PROVIDER=none
ALLOW_EXTERNAL_LLM=false
LLM_TIMEOUT_SECONDS=60
# 0 по умолчанию; максимум 2 повтора только HTTP 429 с коротким Retry-After.
LLM_MAX_RETRIES=0
# Необязательные локальные орфография/грамматика: профиль Docker language.
LANGUAGE_TOOL_ENABLED=false
LANGUAGE_TOOL_TIMEOUT_SECONDS=20

# Process-local cache of completed heavy-analysis report references; no source file storage.
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_TTL_SECONDS=900
ANALYSIS_CACHE_MAX_ENTRIES=128
MAX_DOCUMENT_BYTES=5242880
# Случайный секрет HMAC для защиты ключей идемпотентности; генерируется setup_local.py.
IDEMPOTENCY_SECRET=
# В Compose токен автоматически передаётся API как OPENCLAW_API_KEY.
# setup_local.py генерирует случайный токен, не показывая его в терминале.
OPENCLAW_GATEWAY_TOKEN=
# Эти настройки нужны только при запуске Python вне Compose:
OPENCLAW_BASE_URL=http://openclaw:18789/v1
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw/sed-dss
# Выбор модели ЗА OpenClaw: yandex | gigachat | zai. Ollama и Llama запрещены.
MODEL_BACKEND=yandex
# Ключ Яндекса передаётся только контейнеру OpenClaw.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash
# Z.AI: Standard API Key, не подписка Coding Plan. Ключ получает только OpenClaw.
ZAI_API_KEY=
# Только бесплатные Flash-модели: glm-4.7-flash | glm-4.5-flash.
ZAI_MODEL=glm-4.7-flash
# Необязательный альтернативный backend: docker compose --profile gigachat up -d --build
# Ключ Сбера передаётся только внутреннему OAuth-адаптеру model-bridge.
MODEL_BRIDGE_API_KEY=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
